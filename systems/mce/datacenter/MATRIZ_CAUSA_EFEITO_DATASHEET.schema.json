{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MCE_INDEPENDENTE - DataSheet da ferramenta matriz-causa-efeito",
  "description": "Metadados privados de pre-analise. Nao representa logica, edicao de Excel ou aceite tecnico.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "product", "tool", "run_id", "status", "mce_workflow_phase",
    "template_sha256", "source_manifest_sha256", "input_manifest_sha256",
    "sources", "missing_adapters", "cause_effect_relations_documented",
    "cause_effect_relations_approved", "matrix_edit_authorized",
    "human_review_required", "master_workbook_modified", "production_complete", "next_gate"
  ],
  "properties": {
    "schema": {"const": "mce.matriz-tool.datasheet.v1"},
    "product": {"const": "MCE_INDEPENDENTE"},
    "tool": {"const": "matriz-causa-efeito"},
    "run_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,35}$"},
    "status": {"const": "PRE_ANALISE_PENDENTE_REVISAO"},
    "mce_workflow_phase": {"const": "INVENTARIADO"},
    "template_sha256": {"$ref": "#/$defs/sha256"},
    "source_manifest_sha256": {"$ref": "#/$defs/sha256"},
    "input_manifest_sha256": {"$ref": "#/$defs/sha256"},
    "sources": {
      "type": "array", "minItems": 1, "maxItems": 4,
      "items": {
        "type": "object",
        "required": ["adapter", "repository", "output_name", "output_sha256", "review_status"],
        "properties": {
          "adapter": {"enum": ["azure", "houston", "industrial", "io_compare"]},
          "repository": {"type": "string", "minLength": 1},
          "source_sha256": {"$ref": "#/$defs/sha256"},
          "output_sha256": {"$ref": "#/$defs/sha256"},
          "document": {"type": "string"},
          "revision": {"type": "string"},
          "evidence_location": {"type": "string"},
          "source_name": {"type": "string"},
          "output_name": {"type": "string"},
          "component_candidates": {"type": "integer", "minimum": 0},
          "connection_candidates": {"type": "integer", "minimum": 0},
          "ocr_observations": {"type": "integer", "minimum": 0},
          "example_only": {"type": "boolean"},
          "review_status": {"const": "PENDENTE_REVISAO_ENGENHARIA"}
        },
        "additionalProperties": false
      }
    },
    "missing_adapters": {
      "type": "array", "uniqueItems": true,
      "items": {"enum": ["azure", "houston", "industrial"]}
    },
    "cause_effect_relations_documented": {"const": 0},
    "cause_effect_relations_approved": {"const": 0},
    "matrix_edit_authorized": {"const": false},
    "human_review_required": {"const": true},
    "master_workbook_modified": {"const": false},
    "production_complete": {"const": false},
    "next_gate": {"const": "REVISAR_FONTES_E_EXECUTAR_UNDERSTAND_COM_PID_INTEGRATION_REVIEW"}
  },
  "$defs": {"sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
}