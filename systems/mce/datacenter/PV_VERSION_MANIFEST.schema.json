{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MCE PV append-only version metadata (private workspace)",
  "description": "Schema for one private version record, never an engineering approval or data-content archive.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "document_name",
    "filename",
    "pv_number",
    "sha256",
    "source_sha256",
    "previous_pv_sha256",
    "prev_digest",
    "digest",
    "created_utc",
    "state",
    "engineering_approved",
    "production_complete"
  ],
  "properties": {
    "schema": {
      "const": "mce.pv.version.v1"
    },
    "document_name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "filename": {
      "type": "string",
      "minLength": 15,
      "maxLength": 230
    },
    "pv_number": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9999
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "source_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "previous_pv_sha256": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      ]
    },
    "prev_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "created_utc": {
      "type": "string",
      "format": "date-time"
    },
    "state": {
      "const": "PRELIMINAR_NAO_HOMOLOGADA"
    },
    "engineering_approved": {
      "const": false
    },
    "production_complete": {
      "const": false
    }
  }
}
