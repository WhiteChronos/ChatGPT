      "label": "Toolkit: pesquisar Graphify offline",
      "type": "process",
      "command": "python",
      "args": ["${workspaceFolder}/plugins/vibe-coding-toolkit/reference.py", "search", "Graphify"],
      "problemMatcher": []
    },
    {
      "label": "Toolkit: testar consulta portatil",
