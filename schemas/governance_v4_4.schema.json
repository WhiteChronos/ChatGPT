{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Governance Configuration v4.4",
  "description": "Schema de validação para configuração de governance v4.4",
  "type": "object",
  "properties": {
    "external_mm": {
      "type": "object",
      "const": 12,
      "description": "Resolução externa em milímetros"
    },
    "aspect_ratio": {
      "type": "object",
      "const": 1,
      "description": "Proporção de aspecto padrão"
    },
    "version": {
      "type": "string",
      "const": "4.4",
      "description": "Versão do schema"
    },
    "states": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": ["CMD", "RUN", "FAULT"]
      },
      "description": "Estados de processamento válidos"
    }
  },
  "required": ["external_mm", "aspect_ratio"],
  "additionalProperties": true
}
