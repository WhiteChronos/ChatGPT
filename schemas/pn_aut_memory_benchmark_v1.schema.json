{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "benchmark_id",
    "schema_version",
    "cases"
  ],
  "properties": {
    "benchmark_id": {
      "const": "PN-AUT-MEMORY-BENCHMARK-V1"
    },
    "schema_version": {
      "const": "1.0"
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "case_id",
          "category",
          "query",
          "panel_id",
          "panel_revision",
          "must_include_event_ids",
          "must_exclude_event_ids"
        ],
        "properties": {
          "case_id": {
            "type": "string",
            "minLength": 1
          },
          "category": {
            "type": "string",
            "minLength": 1
          },
          "query": {
            "type": "string",
            "minLength": 1
          },
          "panel_id": {
            "enum": [
              "PN-AUT-01",
              "PN-AUT-02"
            ]
          },
          "panel_revision": {
            "type": "string",
            "minLength": 1
          },
          "must_include_event_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "must_exclude_event_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}
