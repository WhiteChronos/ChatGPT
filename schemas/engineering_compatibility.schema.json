{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/WhiteChronos/ChatGPT/schemas/engineering_compatibility.schema.json",
  "title": "Engineering Compatibility Datasheet v1.2",
  "type": "object",
  "required": [
    "project",
    "baseline",
    "assessment_records",
    "scope_summary",
    "coverage",
    "compatibility",
    "blocking_missing_documents",
    "findings",
    "release_gate",
    "visualization",
    "protocol_zero",
    "analysis_profile",
    "reference_library",
    "report_model"
  ],
  "properties": {
    "project": {
      "$ref": "#/$defs/nonblank"
    },
    "baseline": {
      "type": "object",
      "required": [
        "disciplines",
        "documents",
        "reconciled",
        "reconciliation_note",
        "required_document_ids"
      ],
      "properties": {
        "disciplines": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/discipline_id"
          }
        },
        "documents": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/document"
          }
        },
        "reconciled": {
          "type": "boolean"
        },
        "reconciliation_note": {
          "$ref": "#/$defs/nonblank"
        },
        "required_document_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/nonblank"
          }
        }
      },
      "additionalProperties": false
    },
    "assessment_records": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/assessment_record"
      }
    },
    "scope_summary": {
      "type": "object",
      "required": [
        "VERIFIED",
        "PARTIAL",
        "DIVERGENT",
        "NOT_VERIFIABLE",
        "NOT_APPLICABLE"
      ],
      "properties": {
        "VERIFIED": {
          "type": "integer",
          "minimum": 0
        },
        "PARTIAL": {
          "type": "integer",
          "minimum": 0
        },
        "DIVERGENT": {
          "type": "integer",
          "minimum": 0
        },
        "NOT_VERIFIABLE": {
          "type": "integer",
          "minimum": 0
        },
        "NOT_APPLICABLE": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "coverage": {
      "type": "number",
      "minimum": 0,
      "maximum": 100
    },
    "compatibility": {
      "type": "object",
      "required": [
        "global",
        "by_discipline",
        "by_document",
        "interface",
        "method"
      ],
      "properties": {
        "global": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "by_discipline": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": "number",
            "minimum": 0,
            "maximum": 100
          }
        },
        "by_document": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": "number",
            "minimum": 0,
            "maximum": 100
          }
        },
        "interface": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "method": {
          "$ref": "#/$defs/calculation_method"
        }
      },
      "additionalProperties": false
    },
    "blocking_missing_documents": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/nonblank"
      }
    },
    "release_gate": {
      "enum": [
        "PASS",
        "BLOCK"
      ]
    },
    "visualization": {
      "type": "object",
      "required": [
        "model",
        "complete_not_summary",
        "severity_colors",
        "mandatory_sections",
        "question_batches_are_visualize_artifacts"
      ],
      "properties": {
        "model": {
          "const": "VISUALIZE_GOLDEN_RULE_v1_0"
        },
        "complete_not_summary": {
          "const": true
        },
        "severity_colors": {
          "type": "object",
          "required": [
            "CRITICAL",
            "HIGH",
            "MEDIUM",
            "LOW",
            "NOT_VERIFIABLE",
            "VERIFIED",
            "NOT_APPLICABLE"
          ],
          "properties": {
            "CRITICAL": {
              "const": "red"
            },
            "HIGH": {
              "const": "orange"
            },
            "MEDIUM": {
              "const": "yellow"
            },
            "LOW": {
              "const": "blue"
            },
            "NOT_VERIFIABLE": {
              "const": "blue"
            },
            "VERIFIED": {
              "const": "green"
            },
            "NOT_APPLICABLE": {
              "const": "gray"
            }
          },
          "additionalProperties": false
        },
        "mandatory_sections": {
          "type": "array",
          "minItems": 8,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/nonblank"
          }
        },
        "question_batches_are_visualize_artifacts": {
          "const": true
        }
      },
      "additionalProperties": false
    },
    "findings": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/finding"
      }
    },
    "protocol_zero": {
      "$ref": "#/$defs/protocol_zero"
    },
    "analysis_profile": {
      "$ref": "#/$defs/analysis_profile"
    },
    "reference_library": {
      "$ref": "#/$defs/reference_library_record"
    },
    "report_model": {
      "$ref": "#/$defs/report_model_record"
    }
  },
  "$defs": {
    "nonblank": {
      "type": "string",
      "pattern": "\\S"
    },
    "criterion_id": {
      "type": "string",
      "pattern": "^[A-Z0-9][A-Z0-9._:-]{0,127}$"
    },
    "discipline_id": {
      "type": "string",
      "pattern": "^[A-Z0-9][A-Z0-9._:-]{0,63}$"
    },
    "document": {
      "type": "object",
      "required": [
        "id",
        "discipline",
        "revision",
        "source",
        "sha256",
        "status"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/nonblank"
        },
        "discipline": {
          "$ref": "#/$defs/discipline_id"
        },
        "revision": {
          "$ref": "#/$defs/nonblank"
        },
        "source": {
          "$ref": "#/$defs/nonblank"
        },
        "sha256": {
          "type": "string",
          "minLength": 64,
          "maxLength": 64,
          "pattern": "^[A-Fa-f0-9]{64}$"
        },
        "status": {
          "enum": [
            "CURRENT",
            "APPROVED",
            "REFERENCE",
            "SUPERSEDED",
            "DRAFT"
          ]
        }
      },
      "additionalProperties": false
    },
    "assessment_record": {
      "type": "object",
      "required": [
        "id",
        "criterion_id",
        "criterion",
        "classification",
        "disciplines",
        "document_ids",
        "interface",
        "evidence",
        "evidence_quality"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/nonblank"
        },
        "criterion_id": {
          "$ref": "#/$defs/criterion_id"
        },
        "criterion": {
          "$ref": "#/$defs/nonblank"
        },
        "classification": {
          "enum": [
            "VERIFIED",
            "PARTIAL",
            "DIVERGENT",
            "NOT_VERIFIABLE",
            "NOT_APPLICABLE"
          ]
        },
        "disciplines": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/discipline_id"
          }
        },
        "document_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/nonblank"
          }
        },
        "interface": {
          "type": "boolean"
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/evidence"
          }
        },
        "evidence_quality": {
          "$ref": "#/$defs/evidence_quality"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "interface": {
                "const": true
              }
            },
            "required": [
              "interface"
            ]
          },
          "then": {
            "properties": {
              "disciplines": {
                "minItems": 2
              }
            }
          }
        }
      ],
      "additionalProperties": false
    },
    "evidence": {
      "type": "object",
      "required": [
        "document_id",
        "revision",
        "location",
        "statement",
        "source_hash"
      ],
      "properties": {
        "document_id": {
          "$ref": "#/$defs/nonblank"
        },
        "revision": {
          "$ref": "#/$defs/nonblank"
        },
        "location": {
          "$ref": "#/$defs/nonblank"
        },
        "tag": {
          "type": "string"
        },
        "statement": {
          "$ref": "#/$defs/nonblank"
        },
        "value": {},
        "unit": {
          "type": "string"
        },
        "source_hash": {
          "type": "string",
          "minLength": 64,
          "maxLength": 64,
          "pattern": "^[A-Fa-f0-9]{64}$"
        }
      },
      "additionalProperties": false
    },
    "evidence_quality": {
      "type": "object",
      "required": [
        "rating",
        "rationale"
      ],
      "properties": {
        "rating": {
          "enum": [
            "HIGH",
            "MEDIUM",
            "LOW"
          ]
        },
        "rationale": {
          "$ref": "#/$defs/nonblank"
        }
      },
      "additionalProperties": false
    },
    "claim_basis_kind": {
      "enum": [
        "SOURCE_DERIVED",
        "INFERENCE",
        "EXTERNAL_KNOWLEDGE"
      ]
    },
    "claim_basis": {
      "type": "object",
      "required": [
        "comparison",
        "problem",
        "root_cause",
        "solution"
      ],
      "properties": {
        "comparison": {
          "$ref": "#/$defs/claim_basis_kind"
        },
        "problem": {
          "$ref": "#/$defs/claim_basis_kind"
        },
        "root_cause": {
          "$ref": "#/$defs/claim_basis_kind"
        },
        "solution": {
          "$ref": "#/$defs/claim_basis_kind"
        },
        "viability": {
          "$ref": "#/$defs/claim_basis_kind"
        }
      },
      "additionalProperties": false
    },
    "impacts": {
      "type": "object",
      "required": [
        "design",
        "procurement",
        "fabrication",
        "programming",
        "commissioning",
        "operation",
        "maintenance",
        "safety",
        "cost",
        "schedule"
      ],
      "properties": {
        "design": {
          "$ref": "#/$defs/nonblank"
        },
        "procurement": {
          "$ref": "#/$defs/nonblank"
        },
        "fabrication": {
          "$ref": "#/$defs/nonblank"
        },
        "programming": {
          "$ref": "#/$defs/nonblank"
        },
        "commissioning": {
          "$ref": "#/$defs/nonblank"
        },
        "operation": {
          "$ref": "#/$defs/nonblank"
        },
        "maintenance": {
          "$ref": "#/$defs/nonblank"
        },
        "safety": {
          "$ref": "#/$defs/nonblank"
        },
        "cost": {
          "$ref": "#/$defs/nonblank"
        },
        "schedule": {
          "$ref": "#/$defs/nonblank"
        }
      },
      "additionalProperties": false
    },
    "tradeoff_dimension": {
      "type": "object",
      "required": [
        "assessment",
        "rationale"
      ],
      "properties": {
        "assessment": {
          "enum": [
            "IMPROVES",
            "EQUIVALENT",
            "DEGRADES"
          ]
        },
        "rationale": {
          "$ref": "#/$defs/nonblank"
        }
      },
      "additionalProperties": false
    },
    "architecture_tradeoffs": {
      "type": "object",
      "required": [
        "simplicity",
        "safety",
        "cost",
        "maintainability"
      ],
      "properties": {
        "simplicity": {
          "$ref": "#/$defs/tradeoff_dimension"
        },
        "safety": {
          "$ref": "#/$defs/tradeoff_dimension"
        },
        "cost": {
          "$ref": "#/$defs/tradeoff_dimension"
        },
        "maintainability": {
          "$ref": "#/$defs/tradeoff_dimension"
        }
      },
      "additionalProperties": false
    },
    "alternative": {
      "type": "object",
      "required": [
        "name",
        "feasibility",
        "pros",
        "cons",
        "recommended",
        "tradeoffs"
      ],
      "properties": {
        "name": {
          "$ref": "#/$defs/nonblank"
        },
        "feasibility": {
          "$ref": "#/$defs/nonblank"
        },
        "pros": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/nonblank"
          }
        },
        "cons": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/nonblank"
          }
        },
        "recommended": {
          "type": "boolean"
        },
        "tradeoffs": {
          "$ref": "#/$defs/architecture_tradeoffs"
        }
      },
      "additionalProperties": false
    },
    "waiver": {
      "type": "object",
      "required": [
        "reason",
        "approval_record_id"
      ],
      "properties": {
        "reason": {
          "$ref": "#/$defs/nonblank"
        },
        "approval_record_id": {
          "$ref": "#/$defs/nonblank"
        }
      },
      "additionalProperties": false
    },
    "calculation_method": {
      "type": "object",
      "required": [
        "name",
        "formula",
        "denominator_definition",
        "exclude_not_applicable",
        "exclude_not_verifiable",
        "status_weights"
      ],
      "properties": {
        "name": {
          "$ref": "#/$defs/nonblank"
        },
        "formula": {
          "$ref": "#/$defs/nonblank"
        },
        "denominator_definition": {
          "$ref": "#/$defs/nonblank"
        },
        "exclude_not_applicable": {
          "const": true
        },
        "exclude_not_verifiable": {
          "const": true
        },
        "status_weights": {
          "type": "object",
          "required": [
            "VERIFIED",
            "PARTIAL",
            "DIVERGENT"
          ],
          "properties": {
            "VERIFIED": {
              "const": 1
            },
            "PARTIAL": {
              "const": 0.5
            },
            "DIVERGENT": {
              "const": 0
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "finding": {
      "type": "object",
      "required": [
        "id",
        "assessment_id",
        "severity",
        "classification",
        "status",
        "disciplines",
        "evidence",
        "evidence_quality",
        "comparison",
        "problem",
        "root_cause",
        "claim_basis",
        "impacts",
        "solution",
        "architecture_impact",
        "primary_document",
        "secondary_documents",
        "owner",
        "dependencies",
        "closure_criterion",
        "confidence"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/nonblank"
        },
        "assessment_id": {
          "$ref": "#/$defs/nonblank"
        },
        "severity": {
          "enum": [
            "CRITICAL",
            "HIGH",
            "MEDIUM",
            "LOW"
          ]
        },
        "classification": {
          "enum": [
            "VERIFIED",
            "PARTIAL",
            "DIVERGENT",
            "NOT_VERIFIABLE",
            "NOT_APPLICABLE"
          ]
        },
        "status": {
          "enum": [
            "OPEN",
            "IN_REVIEW",
            "CLOSED",
            "WAIVED"
          ]
        },
        "disciplines": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/discipline_id"
          }
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/evidence"
          }
        },
        "evidence_quality": {
          "$ref": "#/$defs/evidence_quality"
        },
        "comparison": {
          "$ref": "#/$defs/nonblank"
        },
        "problem": {
          "$ref": "#/$defs/nonblank"
        },
        "root_cause": {
          "$ref": "#/$defs/nonblank"
        },
        "claim_basis": {
          "$ref": "#/$defs/claim_basis"
        },
        "impacts": {
          "$ref": "#/$defs/impacts"
        },
        "solution": {
          "$ref": "#/$defs/nonblank"
        },
        "architecture_impact": {
          "type": "boolean"
        },
        "alternatives": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/alternative"
          }
        },
        "viability": {
          "$ref": "#/$defs/nonblank"
        },
        "primary_document": {
          "$ref": "#/$defs/nonblank"
        },
        "secondary_documents": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/nonblank"
          }
        },
        "proposed_text": {
          "type": "string"
        },
        "owner": {
          "$ref": "#/$defs/nonblank"
        },
        "dependencies": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/nonblank"
          }
        },
        "closure_criterion": {
          "$ref": "#/$defs/nonblank"
        },
        "confidence": {
          "enum": [
            "HIGH",
            "MEDIUM",
            "LOW"
          ]
        },
        "waiver": {
          "$ref": "#/$defs/waiver"
        },
        "documents_involved": {
          "$ref": "#/$defs/documents_involved"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "WAIVED"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "required": [
              "waiver"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "architecture_impact": {
                "const": true
              }
            },
            "required": [
              "architecture_impact"
            ]
          },
          "then": {
            "required": [
              "alternatives",
              "viability"
            ],
            "properties": {
              "alternatives": {
                "minItems": 1
              },
              "claim_basis": {
                "required": [
                  "viability"
                ]
              }
            }
          }
        }
      ],
      "additionalProperties": false
    },
    "protocol_question": {
      "type": "object",
      "required": [
        "id",
        "question",
        "answer",
        "status",
        "promotes_to_finding",
        "source_checks",
        "pre_escalation_search_completed"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/nonblank"
        },
        "question": {
          "$ref": "#/$defs/nonblank"
        },
        "answer": {
          "type": "string"
        },
        "status": {
          "enum": [
            "ANSWERED",
            "UNANSWERED"
          ]
        },
        "promotes_to_finding": {
          "type": "boolean"
        },
        "source_checks": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/source_check"
          }
        },
        "pre_escalation_search_completed": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "protocol_zero": {
      "type": "object",
      "required": [
        "policy",
        "unresolved_count",
        "questions"
      ],
      "properties": {
        "policy": {
          "const": "QUESTION_BEFORE_FINDING"
        },
        "unresolved_count": {
          "type": "integer",
          "minimum": 0
        },
        "questions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/protocol_question"
          }
        }
      },
      "additionalProperties": false
    },
    "analysis_profile": {
      "type": "object",
      "required": [
        "model",
        "automation_hyperfocus",
        "data_lineage_required",
        "failure_mode_review_required",
        "reference_library_check_required",
        "documents_involved_required",
        "source_check_before_question_required",
        "visualize_default",
        "question_visual_contract_required"
      ],
      "properties": {
        "model": {
          "const": "AUTOMATION_HYPERFOCUS_GOLDEN_RULE_v1_0"
        },
        "automation_hyperfocus": {
          "const": true
        },
        "data_lineage_required": {
          "const": true
        },
        "failure_mode_review_required": {
          "const": true
        },
        "reference_library_check_required": {
          "const": true
        },
        "documents_involved_required": {
          "const": true
        },
        "source_check_before_question_required": {
          "const": true
        },
        "visualize_default": {
          "const": true
        },
        "question_visual_contract_required": {
          "const": true
        }
      },
      "additionalProperties": false
    },
    "involved_document": {
      "type": "object",
      "required": [
        "document_id",
        "revision",
        "applicability",
        "note"
      ],
      "properties": {
        "document_id": {
          "$ref": "#/$defs/nonblank"
        },
        "revision": {
          "$ref": "#/$defs/nonblank"
        },
        "applicability": {
          "enum": [
            "APPLICABLE",
            "REFERENCE_ONLY",
            "NOT_APPLICABLE",
            "PENDING"
          ]
        },
        "note": {
          "$ref": "#/$defs/nonblank"
        }
      },
      "additionalProperties": false
    },
    "documents_involved": {
      "type": "object",
      "required": [
        "source_evidence",
        "project_correlated_or_conflicting",
        "normative_or_reference",
        "documents_to_correct"
      ],
      "properties": {
        "source_evidence": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/involved_document"
          }
        },
        "project_correlated_or_conflicting": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/involved_document"
          }
        },
        "normative_or_reference": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/involved_document"
          }
        },
        "documents_to_correct": {
          "type": "array",
          "minItems": 1,
