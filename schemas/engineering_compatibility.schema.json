{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/WhiteChronos/ChatGPT/schemas/engineering_compatibility.schema.json",
  "title": "Engineering Compatibility Datasheet",
  "type": "object",
  "required": ["project", "baseline", "coverage", "compatibility", "findings"],
  "properties": {
    "project": {"type": "string"},
    "baseline": {
      "type": "object",
      "required": ["disciplines", "documents"],
      "properties": {
        "disciplines": {"type": "array", "items": {"type": "string"}},
        "documents": {"type": "array", "items": {"$ref": "#/$defs/document"}}
      }
    },
    "coverage": {"type": "number", "minimum": 0, "maximum": 100},
    "compatibility": {
      "type": "object",
      "required": ["global", "by_discipline"],
      "properties": {
        "global": {"type": "number", "minimum": 0, "maximum": 100},
        "by_discipline": {"type": "object", "additionalProperties": {"type": "number", "minimum": 0, "maximum": 100}},
        "interface": {"type": "number", "minimum": 0, "maximum": 100},
        "method": {"type": "string"}
      }
    },
    "blocking_missing_documents": {"type": "array", "items": {"type": "string"}},
    "findings": {"type": "array", "items": {"$ref": "#/$defs/finding"}}
  },
  "$defs": {
    "document": {
      "type": "object",
      "required": ["id", "discipline", "revision", "source"],
      "properties": {
        "id": {"type": "string"},
        "discipline": {"type": "string"},
        "revision": {"type": "string"},
        "source": {"type": "string"},
        "sha256": {"type": "string"}
      }
    },
    "evidence": {
      "type": "object",
      "required": ["document_id", "location", "statement"],
      "properties": {
        "document_id": {"type": "string"},
        "revision": {"type": "string"},
        "location": {"type": "string"},
        "tag": {"type": "string"},
        "statement": {"type": "string"},
        "value": {},
        "unit": {"type": "string"}
      }
    },
    "finding": {
      "type": "object",
      "required": ["id", "severity", "classification", "disciplines", "evidence", "problem", "solution", "primary_document", "closure_criterion"],
      "properties": {
        "id": {"type": "string"},
        "severity": {"enum": ["CRITICAL", "HIGH", "MEDIUM", "LOW"]},
        "classification": {"enum": ["VERIFIED", "PARTIAL", "DIVERGENT", "NOT_VERIFIABLE", "NOT_APPLICABLE"]},
        "disciplines": {"type": "array", "items": {"type": "string"}},
        "evidence": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/evidence"}},
        "problem": {"type": "string"},
        "root_cause": {"type": "string"},
        "impacts": {"type": "object", "additionalProperties": {"type": "string"}},
        "solution": {"type": "string"},
        "alternatives": {"type": "array", "items": {"type": "object", "properties": {"name": {"type": "string"}, "feasibility": {"type": "string"}, "pros": {"type": "array", "items": {"type": "string"}}, "cons": {"type": "array", "items": {"type": "string"}}}}},
        "primary_document": {"type": "string"},
        "secondary_documents": {"type": "array", "items": {"type": "string"}},
        "proposed_text": {"type": "string"},
        "owner": {"type": "string"},
        "dependencies": {"type": "array", "items": {"type": "string"}},
        "closure_criterion": {"type": "string"},
        "confidence": {"enum": ["HIGH", "MEDIUM", "LOW"]}
      }
    }
  }
}
