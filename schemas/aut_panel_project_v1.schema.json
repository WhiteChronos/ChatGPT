{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/WhiteChronos/ChatGPT/schemas/aut_panel_project_v1.schema.json",
  "title": "AUT Panel Project",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "project", "production_contract", "enclosure", "render", "views", "layout", "architecture", "placements"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "revision", "engineering_level", "standard_id"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "title": {"type": "string", "minLength": 1},
        "revision": {"type": "string", "pattern": "^R[0-9]{2}$"},
        "engineering_level": {"enum": ["CONCEPTUAL", "BASIC", "EXECUTIVE"]},
        "standard_id": {"const": "AUT-PAINEL-COMPACT-V2.4"}
      }
    },
    "production_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["golden_rule", "bom_before_render", "bom_is_render_source", "image_must_match_bom", "bom_change_invalidates_existing_image"],
      "properties": {
        "golden_rule": {"const": "GR-034"},
        "bom_before_render": {"const": true},
        "bom_is_render_source": {"const": true},
        "image_must_match_bom": {"const": true},
        "bom_change_invalidates_existing_image": {"const": true}
      }
    },
    "enclosure": {
      "type": "object",
      "additionalProperties": false,
      "required": ["catalog_id", "manufacturer", "family", "model", "external_mm", "mounting_plate_mm", "minimum_free_reserve_percent"],
      "properties": {
        "catalog_id": {"type": "string", "minLength": 1},
        "manufacturer": {"type": "string", "minLength": 1},
        "family": {"type": "string", "minLength": 1},
        "model": {"type": "string", "minLength": 1},
        "external_mm": {"$ref": "#/$defs/box3d"},
        "mounting_plate_mm": {"$ref": "#/$defs/box2d"},
        "minimum_free_reserve_percent": {"type": "number", "minimum": 0, "maximum": 80},
        "ip_rating": {"type": ["string", "null"]},
        "ik_rating": {"type": ["string", "null"]}
      }
    },
    "render": {
      "type": "object",
      "additionalProperties": false,
      "required": ["px_per_mm", "single_global_scale", "aspect_equal", "allow_component_scale_override", "allow_stretch", "canvas_policy", "front_external_master_geometry"],
      "properties": {
        "px_per_mm": {"type": "number", "exclusiveMinimum": 0},
        "single_global_scale": {"const": true},
        "aspect_equal": {"const": true},
        "allow_component_scale_override": {"const": false},
        "allow_stretch": {"const": false},
        "canvas_policy": {"const": "grow_only"},
        "front_external_master_geometry": {"const": true}
      }
    },
    "views": {
      "type": "object",
      "additionalProperties": false,
      "required": ["front_external_mm", "front_internal_mm", "side_external_mm"],
      "properties": {
        "front_external_mm": {"$ref": "#/$defs/box2d"},
        "front_internal_mm": {"$ref": "#/$defs/box2d"},
        "side_external_mm": {"$ref": "#/$defs/box2d"}
      }
    },
    "layout": {
      "type": "object",
      "additionalProperties": false,
      "required": ["bottom_zone", "fixed_occupied_area_mm2"],
      "properties": {
        "fixed_occupied_area_mm2": {"type": "number", "minimum": 0},
        "bottom_zone": {
          "type": "object",
          "additionalProperties": false,
          "required": ["cable_exit_height_mm", "lower_wireway_height_mm", "minimum_bend_clearance_mm", "terminal_zone_bottom_y_mm", "cable_glands_count"],
          "properties": {
            "cable_exit_height_mm": {"type": "number", "minimum": 0},
            "lower_wireway_height_mm": {"type": "number", "minimum": 0},
            "minimum_bend_clearance_mm": {"type": "number", "minimum": 0},
            "terminal_zone_bottom_y_mm": {"type": "number", "minimum": 0},
            "cable_glands_count": {"type": "integer", "minimum": 0}
          }
        }
      }
    },
    "architecture": {
      "type": "object",
      "additionalProperties": false,
      "required": ["controller_type", "controller_catalog_id", "io_catalog_ids", "protocols"],
      "properties": {
        "controller_type": {"enum": ["RTU", "PLC", "PAC"]},
        "controller_catalog_id": {"type": "string", "minLength": 1},
        "io_catalog_ids": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
        "protocols": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true}
      }
    },
    "placements": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["instance_id", "catalog_id", "surface", "x_mm", "y_mm", "rotation_deg"],
        "properties": {
          "instance_id": {"type": "string", "minLength": 1},
          "catalog_id": {"type": "string", "minLength": 1},
          "surface": {"enum": ["mounting_plate", "door"]},
          "x_mm": {"type": "number", "minimum": 0},
          "y_mm": {"type": "number", "minimum": 0},
          "rotation_deg": {"enum": [0, 90, 180, 270]}
        }
      }
    }
  },
  "$defs": {
    "box2d": {
      "type": "object",
      "additionalProperties": false,
      "required": ["width", "height"],
      "properties": {
        "width": {"type": "number", "exclusiveMinimum": 0},
        "height": {"type": "number", "exclusiveMinimum": 0}
      }
    },
    "box3d": {
      "type": "object",
      "additionalProperties": false,
      "required": ["width", "height", "depth"],
      "properties": {
        "width": {"type": "number", "exclusiveMinimum": 0},
        "height": {"type": "number", "exclusiveMinimum": 0},
        "depth": {"type": "number", "exclusiveMinimum": 0}
      }
    }
  }
}
