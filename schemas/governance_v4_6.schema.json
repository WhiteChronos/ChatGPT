{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AUTOMACAO Governance v4.6",
  "type": "object",
  "required": ["golden_rules", "symbol_standard", "memory_policy", "document_policy"],
  "properties": {
    "symbol_standard": {
      "type": "object",
      "required": ["name", "external_mm", "aspect_ratio", "families", "locations"],
      "properties": {
        "name": {"const": "AUTOMACAO DM R00-05"},
        "external_mm": {"const": 12},
        "aspect_ratio": {"const": 1},
        "families": {"const": ["DISCRETE", "SHARED_DISPLAY", "COMPUTER", "PLC"]},
        "locations": {"const": ["FIELD", "MAIN_PANEL", "BEHIND_MAIN_PANEL", "LOCAL_PANEL"]}
      },
      "additionalProperties": false
    },
    "golden_rules": {
      "type": "array",
      "minItems": 10,
      "items": {"type": "string"}
    },
    "memory_policy": {
      "type": "object",
      "required": ["memory_event", "prevention_rule", "regression_case"],
      "properties": {
        "memory_event": {"type": "string", "minLength": 1},
        "prevention_rule": {"type": "string", "minLength": 1},
        "regression_case": {"type": "string", "minLength": 1}
      }
    },
    "critical_signal_roles": {
      "const": ["CMD", "RUN", "FAULT", "AVAILABLE"]
    },
    "document_policy": {
      "type": "object",
      "required": ["layout_immutable", "sheet_count_source", "plugin_auto_install"],
      "properties": {
        "layout_immutable": {"const": true},
        "sheet_count_source": {"const": "TARGET_DOCUMENT"},
        "plugin_auto_install": {"const": false}
      },
      "additionalProperties": true
    },
    "li_io_model": {
      "type": "object",
      "required": [
        "model_id",
        "layout_signature_match",
        "font_signature_match",
        "target_sheet_count",
        "final_page_count",
        "declared_total_pages"
      ],
      "properties": {
        "model_id": {"const": "LI_IO_PETROBRAS_AUTOMACAO_V1_0"},
        "sheet_count_source": {"const": "TARGET_DOCUMENT"},
        "template_sheet_count_forced": {"const": false},
        "layout_signature_match": {"const": true},
        "font_signature_match": {"const": true},
        "cell_dimensions_match": {"const": true},
        "print_settings_match": {"const": true},
        "ad_hoc_note_on_final_sheet": {"const": false},
        "target_sheet_count": {"type": "integer", "minimum": 1},
        "final_page_count": {"type": "integer", "minimum": 1},
        "declared_total_pages": {"type": "integer", "minimum": 1}
      },
      "additionalProperties": true
    }
  }
}
