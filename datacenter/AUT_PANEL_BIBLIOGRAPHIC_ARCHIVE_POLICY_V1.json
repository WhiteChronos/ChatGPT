    "manufacturer_support": "manufacturer_support/",
    "bibliography": "bibliography/"
  },
  "controlled_copy_status": [
    "ARCHIVED_OPEN_ACCESS",
    "ARCHIVED_PUBLIC_OFFICIAL",
    "ARCHIVED_USER_SUPPLIED_LICENSED",
