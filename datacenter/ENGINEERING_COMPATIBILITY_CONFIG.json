    "MEDIUM": "yellow",
    "LOW": "blue",
    "NOT_VERIFIABLE": "blue",
    "VERIFIED": "green",
    "NOT_APPLICABLE": "gray"
  },
  "thresholds": {
    "minimum_coverage_percent": 85,
    "minimum_global_compatibility_percent": 80,
    "minimum_interface_compatibility_percent": 80,
    "metric_tolerance_percent": 0.05,
    "block_on_open_critical": true,
