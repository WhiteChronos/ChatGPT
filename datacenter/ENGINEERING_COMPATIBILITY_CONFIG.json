    "require_document_scores": true,
    "require_discipline_scores": true,
    "require_architecture_viability": true
  },
  "compatibility": {
    "exclude_not_applicable_from_denominator": true,
    "exclude_not_verifiable_from_compatibility_denominator": true,
    "not_verifiable_reduces_coverage": true,
    "require_method_disclosure": true,
    "required_status_weights": {
      "VERIFIED": 1,
      "PARTIAL": 0.5,
      "DIVERGENT": 0
    }
  },
  "visualization": {
    "complete_not_summary": true,
    "mandatory_sections": [
      "executive_gate",
      "baseline_map",
      "compatibility_by_discipline",
      "compatibility_by_document",
      "interfaces",
      "complete_findings",
      "feasibility",
      "missing_evidence",
      "action_plan",
      "release_gate"
    ],
    "renderer": {
      "strategy": "PROGRESSIVE_ENHANCEMENT",
      "primary": {
        "name": "Visualize",
        "required": true,
        "interactive_required_when_available": true,
        "allow_markdown_only_as_visualize": false
      },
      "enhanced": {
        "plugin_id": "Plugin_40dab999fe9c8191bbc2f550371692fc",
        "display_name": "Build Web Data Visualization",
        "preferred_when_executable": true,
        "block_if_unavailable": false,
        "upgrade_without_content_change": true
      }
    },
    "separate_questions_findings_problems": true,
    "require_answer_field_for_open_questions": true
  },
  "datacenter_layout": {
    "raw": "datacenter/raw/<project>/<discipline>/<document>/<revision>/",
