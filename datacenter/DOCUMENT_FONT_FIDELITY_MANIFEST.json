{
  "model_id": "DOCUMENT_FONT_FIDELITY_MANIFEST_V1_0",
  "status": "MANDATORY",
  "policy": {
    "exact_fonts_required_for_layout_sensitive_validation": true,
    "proprietary_font_binaries_must_not_be_committed": true,
    "private_font_directory": "private_fonts/",
    "font_gate": "pipeline/font_fidelity_gate.py",
    "runtime_wrapper": "pipeline/with_private_fonts.sh",
    "missing_exact_font_status": "NOT_VERIFIABLE_FROM_RENDER",
    "fallback_font_never_counts_as_exact": true
  },
  "sources": [
    {
      "family": "Petrobras Sans",
      "classification": "PROPRIETARY_CORPORATE",
      "exact_required": true,
      "official_source": "https://petrobras.com.br/quem-somos/nossa-marca",
      "acquisition": "Authorized Petrobras Brand Content Library / corporate source",
      "redistribution_in_public_repo": false,
      "notes": "Petrobras states that its visual identity uses an exclusive typography and that brand manuals/assets are accessed through the Petrobras brand-content library.",
      "support_fallback": {
        "family": "Trebuchet MS",
        "status": "SUPPORT_ONLY",
        "exact_layout_equivalent": false,
        "basis": "Petrobras/Transpetro identity manuals identify Trebuchet MS as a support font under technical restriction. It must not be used to validate exact Word pagination."
      }
    },
    {
