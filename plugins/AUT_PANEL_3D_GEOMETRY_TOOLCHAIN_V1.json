    "OFFICIAL_DIMENSIONAL_BBOX_PROXY",
    "GENERATIVE_IMAGE_REFERENCE_ONLY"
  ],
  "rules": {
    "unit": "mm",
    "one_geometry_model_per_physical_instance": true,
    "orthographic_views_from_same_3d_assembly": true,
    "bounding_box_must_match_official_dimensions": true,
    "individual_rescaling_forbidden": true,
    "camera_perspective_for_dimension_views": "ORTHOGRAPHIC",
    "render_canvas_policy": "GROW_CANVAS_KEEP_SCALE",
    "generative_model_geometry_authority": false
  },
