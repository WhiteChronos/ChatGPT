{
  "openapi": "3.0.3",
  "info": {
    "title": "Official TypeSafe Jev 1.13 — decisions only",
    "version": "1.0.0",
    "description": "Optional Jev System One evaluation using official TypeSafe API. Requires user-installed Bearer credential. Never transmit private project data without approval. AI decisions are not workflow authorizations."
  },
  "servers": [{"url": "https://api.typesafe.ai"}],
  "paths": {
    "/v1/systemone": {
      "post": {
        "operationId": "askTypesafeJev",
        "summary": "Evaluate bounded choice, score, or noul judgments",
        "description": "Only call on explicit request and authorized nonconfidential state. Cannot merge, deploy or run external tools.",
        "security": [{"TypeSafeBearer": []}],
        "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Evaluation"}}}},
        "responses": {
          "200": {"description": "Typed probabilistic answers", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/EvaluationResponse"}}}},
          "401": {"description": "Unauthorized"},
          "422": {"description": "Validation error"},
          "429": {"description": "Rate limit exceeded"},
          "529": {"description": "Provider overloaded"}
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "TypeSafeBearer": {"type": "http", "scheme": "bearer", "description": "TypeSafe API key. In the GPT editor choose API key authentication / Bearer, then enter the key in the protected field."}
    },
    "schemas": {
      "Evaluation": {
        "type": "object",
        "required": ["model", "state", "questions"],
        "additionalProperties": false,
        "properties": {
          "model": {"type": "string", "enum": ["jev-1.13.0"]},
          "state": {"oneOf": [{"type": "string"}, {"type": "object"}, {"type": "array"}]},
          "questions": {"type": "object", "minProperties": 1, "additionalProperties": {"$ref": "#/components/schemas/Question"}}
        }
      },
      "Question": {
        "type": "object",
        "required": ["type", "instructions"],
        "additionalProperties": false,
        "properties": {
          "type": {"type": "string", "enum": ["choice", "score", "noul"]},
          "instructions": {"type": "string", "minLength": 1},
          "criteria": {"oneOf": [{"type": "object", "additionalProperties": {"type": "string"}}, {"type": "array", "items": {"type": "string"}, "minItems": 2, "maxItems": 10}]}
        }
      },
      "EvaluationResponse": {
        "type": "object",
        "required": ["model", "answers", "usage"],
        "properties": {
          "model": {"type": "string"},
          "answers": {"type": "object", "additionalProperties": {"$ref": "#/components/schemas/Answer"}},
          "usage": {"type": "object", "properties": {"input_tokens": {"type": "integer"}, "output_tokens": {"type": "integer"}}}
        }
      },
      "Answer": {
        "type": "object",
        "properties": {
          "type": {"type": "string", "enum": ["choice", "score", "noul"]},
          "choice": {"type": "string"},
          "score": {"type": "number"},
          "noul": {"type": "number", "minimum": 0, "maximum": 1},
          "probabilities": {"type": "object", "additionalProperties": {"type": "number"}},
          "legend": {"type": "object", "additionalProperties": {"type": "string"}},
          "confidence": {"type": "number", "minimum": 0, "maximum": 1}
        }
      }
    }
  }
}
