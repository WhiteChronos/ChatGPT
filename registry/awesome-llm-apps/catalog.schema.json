{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "WhiteChronos Awesome LLM Apps catalog",
  "type": "object",
  "required": ["schema_version", "upstream_commit", "entries"],
  "properties": {
    "schema_version": {"const": 1},
    "upstream_commit": {"type": "string"},
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "source_type", "category", "execution_class", "upstream_commit"]
      }
    }
  }
}
