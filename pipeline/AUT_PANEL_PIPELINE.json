{
  "schema_version": "1.5",
  "pipeline_id": "AUT-PANEL-GITHUB-QUALITY-V1.5",
  "standard_id": "AUT-PAINEL-COMPACT-V2.4",
  "immutable_yaml_pipeline": "pipeline/pipeline.yaml",
  "golden_rules_yaml": "governance/golden_rules.yaml",
  "panel_template_yaml": "templates/panel_template.yaml",
  "prompt_master": "prompts/PROMPT_MASTER_AUT_PANEL.md",
  "datacenter_yaml": "datacenter/datacenter.yaml",
  "datasheet_yaml": "datasheet/datasheet.yaml",
  "document_standard_registry": "datacenter/AUT_PANEL_DOCUMENT_STANDARDS.json",
  "release_statuses": ["APROVADO", "CONDICIONADO", "HOLD", "REPROVADO"],
  "golden_rules": {
    "GR-034": {"name":"LI/BOM antes da imagem","status":"MANDATORY","rule":"A LI quantitativa e a BOM canônica devem ser elaboradas e validadas antes do desenho."},
    "GR-035": {"name":"Paridade quantitativa LI x desenho","status":"MANDATORY","rule":"Cada item desenhável deve aparecer no Data Sheet/layout e desenho exatamente na quantidade congelada na LI."},
    "GR-036": {"name":"Mudança da LI invalida desenho","status":"MANDATORY","rule":"Qualquer alteração de quantidade, catalog_id ou revisão na LI invalida carga, BOM, layout, imagem e QA anteriores."},
    "GR-037": {"name":"IHM na porta","status":"MANDATORY","rule":"IHM local deve permanecer na tampa/porta do quadro."},
    "GR-038": {"name":"Sem distorção","status":"MANDATORY","rule":"Componentes não podem ser reduzidos ou distorcidos para caber; reorganizar ou ampliar gabinete."},
    "GR-039": {"name":"Padrão único de Excel","status":"MANDATORY","rule":"PN-AUT-01 é o template mestre da planilha. PN-AUT-02 e futuros quadros devem manter a mesma estrutura visual/documental; somente dados técnicos específicos podem variar."},
    "GR-040": {"name":"Padrão visual único da imagem","status":"MANDATORY","rule":"Cada painel deve usar sua imagem aprovada e a composição visual mestre do projeto, uma imagem por painel, sem recomposição não autorizada."},
    "GR-041": {"name":"Padrão aprovado imutável sem autorização","status":"MANDATORY","rule":"Nenhuma alteração do template de Excel, padrão visual, dimensão mestre ou sequência pode ocorrer sem autorização explícita do responsável."},
    "GR-042": {"name":"Baseline da LI imutável","status":"MANDATORY","rule":"A revisão de LI congelada é baseline do painel e só pode mudar mediante nova revisão autorizada."},
    "GR-043": {"name":"Fingerprint estrutural do workbook","status":"MANDATORY","rule":"O workbook deve manter o fingerprint estrutural XLSX-PN-AUT-01-MASTER-R02."},
    "GR-044": {"name":"Fingerprint da imagem aprovada","status":"MANDATORY","rule":"O desenho deve apontar para o ID e SHA-256 da referência visual aprovada do painel."},
    "GR-045": {"name":"Prompt mestre obrigatório","status":"MANDATORY","rule":"O PROMPT-MASTER-AUT-PANEL-V1 deve ser carregado e não pode ser reescrito pelo agente."}
  },
  "standard_sequence": ["DATACENTER","DATASHEET","SELECT","LI_QUANTITY","LOAD_BALANCE","BOM","LAYOUT","RENDER_IMAGE","QA","RELEASE"],
  "mandatory_panel_rules": {
    "independent_panel_model": true,
    "li_required_before_bom": true,
    "li_is_quantity_source": true,
    "load_balance_required_before_layout": true,
    "load_balance_voltages": ["24VDC","127VAC","220VAC"],
    "bom_quantity_must_equal_li": true,
    "layout_quantity_must_equal_li": true,
    "render_quantity_must_equal_li": true,
    "li_change_invalidates_load_bom_layout_render": true,
    "front_external_master_geometry": true,
    "single_global_px_per_mm": true,
    "aspect_equal": true,
    "canvas_grow_only": true,
    "lower_cable_zone_required": true,
    "power_supply_required": true,
    "dc_ups_required": true,
    "battery_required": true,
    "hmi_on_door_required": true,
    "reference_model_required_for_every_li_line": true,
    "hold_when_exact_model_or_evidence_is_missing": true,
    "workbook_master_template_required": true,
    "workbook_master_panel": "PN-AUT-01",
    "workbook_template_id": "XLSX-PN-AUT-01-MASTER-R02",
    "workbook_structural_fingerprint_sha256": "c568858ed6d80cc2ccd4a8859d0a21f88cafddccc10737eda8808555b94530fc",
    "approved_image_visual_standard_required": true,
    "image_visual_standard_id": "IMG-AUT-PANEL-MASTER-V1",
    "one_panel_per_image": true,
    "prompt_master_required": true,
    "prompt_master_id": "PROMPT-MASTER-AUT-PANEL-V1",
    "standard_change_requires_explicit_authorization": true
  },
  "panel_standards": {
    "PN-AUT-01": {
      "role":"MASTER_PLC_VRF","floor":"1","li_file":"li/PN-AUT-01_LI.json","quantity_registry_key":"PN-AUT-01",
      "li_id":"LI-PN-AUT-01-R02","li_revision":"R02",
      "workbook_template_id":"XLSX-PN-AUT-01-MASTER-R02","image_template_id":"IMG-PN-AUT-01-APPROVED-V1",
      "approved_image_sha256":"d5e5e060b1a68eb2f4d11a3e62a05040f0d91514c32c61669c4de03890b79402",
      "enclosure_external_mm":{"width":600,"height":800,"depth":300},"mounting_plate_mm":{"width":550,"height":750},
      "mandatory_categories":["power_supply","dc_ups","battery","plc_controller","hmi","industrial_switch","vrf_gateway","terminal","protective_device"]
    },
    "PN-AUT-02": {
      "role":"REMOTE_RTU","floor":"2","li_file":"li/PN-AUT-02_LI.json","quantity_registry_key":"PN-AUT-02",
      "li_id":"LI-PN-AUT-02-R02","li_revision":"R02",
      "workbook_template_id":"XLSX-PN-AUT-01-MASTER-R02","image_template_id":"IMG-PN-AUT-02-APPROVED-V1",
      "approved_image_sha256":"daf6981a2efad57f0c54eafd7a2d71e42895d47932a3d9ddf5cfdc8918a84d89",
      "enclosure_external_mm":{"width":400,"height":500,"depth":250},"mounting_plate_mm":{"width":350,"height":450},
      "mandatory_categories":["power_supply","dc_ups","battery","rtu_controller","hmi","industrial_switch","terminal","protective_device"]
    }
  },
  "github_quality": {"workflow":".github/workflows/aut-panel-quality.yml","pull_request_required":true,"block_on_rejected":true,"block_release_on_hold":true,"artifact_manifest_required":true},
  "stages": [
    {"order":10,"id":"INIT","input":["project_request"],"output":["project_structure"],"gates":["project_id","revision","panel_id"]},
    {"order":20,"id":"INGEST","input":["MD","ET","LI","PDF","XLSX","images"],"output":["document_manifest"],"gates":["sha256","source_registration"]},
    {"order":50,"id":"DATACENTER","input":["confirmed_requirements","manufacturer_documents"],"output":["verified_catalog","panel_quantity_registry","document_standard_registry","immutable_contracts"],"gates":["manufacturer","reference_model","quantity_registry","golden_rules","document_standard","prompt_master","template_fingerprint"]},
    {"order":60,"id":"DATASHEET","input":["confirmed_requirements","verified_catalog","document_standard_registry"],"output":["canonical_project"],"gates":["json_schema","li_contract","panel_independence","workbook_template_contract","image_template_contract","change_authorization_contract"]},
    {"order":90,"id":"SELECT","input":["calculation_results","verified_catalog"],"output":["selected_components"],"gates":["reference_model","lifecycle"]},
    {"order":100,"id":"LI_QUANTITY","input":["selected_components","panel_quantity_registry"],"output":["validated_li"],"gates":["quantity_positive","catalog_id_exists","registry_match","render_flag","workbook_master_template","li_revision_baseline"]},
    {"order":105,"id":"LOAD_BALANCE","input":["validated_li","verified_catalog"],"output":["equipment_loads","total_24vdc","equivalent_127vac","equivalent_220vac"],"gates":["load_per_equipment","no_invented_consumption","traceability","HOLD_on_missing_load_data"]},
    {"order":110,"id":"BOM","input":["validated_li","verified_catalog","equipment_loads"],"output":["AUT_PANEL_BOM.json","AUT_PANEL_BOM.csv"],"gates":["bom_quantity_equals_li","reference_model_on_every_line"]},
    {"order":120,"id":"LAYOUT","input":["validated_li","equipment_loads","AUT_PANEL_BOM.json","canonical_project"],"output":["physical_layout"],"gates":["layout_quantity_equals_li","GR-018","GR-027","reserve"]},
    {"order":130,"id":"RENDER_IMAGE","input":["physical_layout","validated_li","AUT_PANEL_BOM.json","document_standard_registry","immutable_contracts"],"output":["AUT_PANEL_LAYOUT.svg"],"gates":["render_quantity_equals_li","hmi_on_door","approved_image_template","approved_image_fingerprint","one_panel_per_image","no_unapproved_recomposition","GR-021","GR-022","GR-023","GR-024","GR-025","GR-026","GR-040","GR-041","GR-044","GR-045"]},
    {"order":140,"id":"QA","input":["all_outputs"],"output":["qa_report","artifact_manifest"],"gates":["schema","unit_tests","hashes","cross_consistency","li_before_image","load_before_layout","quantity_parity","workbook_template_parity","image_template_parity","standard_change_authorization"]},
    {"order":150,"id":"RELEASE","input":["qa_report","artifact_manifest"],"output":["release_package"],"gates":["APROVADO","no_HOLD","pull_request_review","two_agent_source_validation","reverification_done"]}
  ]
}
