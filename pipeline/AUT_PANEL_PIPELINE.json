{
  "schema_version": "1.3",
  "pipeline_id": "AUT-PANEL-GITHUB-QUALITY-V1.3",
  "standard_id": "AUT-PAINEL-COMPACT-V2.4",
  "release_statuses": ["APROVADO", "CONDICIONADO", "HOLD", "REPROVADO"],
  "golden_rules": {
    "GR-034": {"name":"LI/BOM antes da imagem","status":"MANDATORY","rule":"A LI quantitativa e a BOM canônica devem ser elaboradas e validadas antes do desenho."},
    "GR-035": {"name":"Paridade quantitativa LI x desenho","status":"MANDATORY","rule":"Cada item desenhável deve aparecer no Data Sheet/layout e desenho exatamente na quantidade congelada na LI."},
    "GR-036": {"name":"Mudança da LI invalida desenho","status":"MANDATORY","rule":"Qualquer alteração de quantidade na LI invalida BOM, layout e imagem anteriores."},
    "GR-037": {"name":"IHM na porta","status":"MANDATORY","rule":"IHM local deve permanecer na tampa/porta do quadro."},
    "GR-038": {"name":"Sem distorção","status":"MANDATORY","rule":"Componentes não podem ser reduzidos ou distorcidos para caber; reorganizar ou ampliar gabinete."}
  },
  "standard_sequence": ["DATACENTER","DATASHEET","SELECT","LI_QUANTITY","BOM","LAYOUT","RENDER_IMAGE","QA","RELEASE"],
  "mandatory_panel_rules": {
    "independent_panel_model": true,
    "li_required_before_bom": true,
    "li_is_quantity_source": true,
    "bom_quantity_must_equal_li": true,
    "layout_quantity_must_equal_li": true,
    "render_quantity_must_equal_li": true,
    "li_change_invalidates_bom_layout_render": true,
    "front_external_master_geometry": true,
    "single_global_px_per_mm": true,
    "aspect_equal": true,
    "canvas_grow_only": true,
    "lower_cable_zone_required": true,
    "power_supply_required": true,
    "dc_ups_required": true,
    "battery_required": true,
    "hmi_on_door_required": true,
    "reference_model_required_for_every_li_line": true,
    "hold_when_exact_model_or_evidence_is_missing": true
  },
  "panel_standards": {
    "PN-AUT-01": {
      "role":"MASTER_PLC_VRF","floor":"1","li_file":"li/PN-AUT-01_LI.json","quantity_registry_key":"PN-AUT-01",
      "enclosure_external_mm":{"width":600,"height":800,"depth":300},"mounting_plate_mm":{"width":550,"height":750},
      "mandatory_categories":["power_supply","dc_ups","battery","plc_controller","hmi","industrial_switch","vrf_gateway","terminal","protective_device"]
    },
    "PN-AUT-02": {
      "role":"REMOTE_RTU","floor":"2","li_file":"li/PN-AUT-02_LI.json","quantity_registry_key":"PN-AUT-02",
      "enclosure_external_mm":{"width":400,"height":500,"depth":250},"mounting_plate_mm":{"width":350,"height":450},
      "mandatory_categories":["power_supply","dc_ups","battery","rtu_controller","hmi","industrial_switch","terminal","protective_device"]
    }
  },
  "github_quality": {"workflow":".github/workflows/aut-panel-quality.yml","pull_request_required":true,"block_on_rejected":true,"block_release_on_hold":true,"artifact_manifest_required":true},
  "stages": [
    {"order":10,"id":"INIT","input":["project_request"],"output":["project_structure"],"gates":["project_id","revision","panel_id"]},
    {"order":20,"id":"INGEST","input":["MD","ET","LI","PDF","XLSX","images"],"output":["document_manifest"],"gates":["sha256","source_registration"]},
    {"order":50,"id":"DATACENTER","input":["confirmed_requirements","manufacturer_documents"],"output":["verified_catalog","panel_quantity_registry"],"gates":["manufacturer","reference_model","quantity_registry","golden_rules"]},
    {"order":60,"id":"DATASHEET","input":["confirmed_requirements","verified_catalog"],"output":["canonical_project"],"gates":["json_schema","li_contract","panel_independence"]},
    {"order":90,"id":"SELECT","input":["calculation_results","verified_catalog"],"output":["selected_components"],"gates":["reference_model","lifecycle"]},
    {"order":100,"id":"LI_QUANTITY","input":["selected_components","panel_quantity_registry"],"output":["validated_li"],"gates":["quantity_positive","catalog_id_exists","registry_match","render_flag"]},
    {"order":110,"id":"BOM","input":["validated_li","verified_catalog"],"output":["AUT_PANEL_BOM.json","AUT_PANEL_BOM.csv"],"gates":["bom_quantity_equals_li","reference_model_on_every_line"]},
    {"order":120,"id":"LAYOUT","input":["validated_li","AUT_PANEL_BOM.json","canonical_project"],"output":["physical_layout"],"gates":["layout_quantity_equals_li","GR-018","GR-027","reserve"]},
    {"order":130,"id":"RENDER_IMAGE","input":["physical_layout","validated_li","AUT_PANEL_BOM.json"],"output":["AUT_PANEL_LAYOUT.svg"],"gates":["render_quantity_equals_li","hmi_on_door","GR-021","GR-022","GR-023","GR-024","GR-025","GR-026"]},
    {"order":140,"id":"QA","input":["all_outputs"],"output":["qa_report","artifact_manifest"],"gates":["schema","unit_tests","hashes","cross_consistency","li_before_image","quantity_parity"]},
    {"order":150,"id":"RELEASE","input":["qa_report","artifact_manifest"],"output":["release_package"],"gates":["APROVADO","no_HOLD","pull_request_review","two_agent_source_validation"]}
  ]
}
