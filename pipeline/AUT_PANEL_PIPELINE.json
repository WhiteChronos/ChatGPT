  "datasheet_yaml": "datasheet/datasheet.yaml",
  "document_standard_registry": "datacenter/AUT_PANEL_DOCUMENT_STANDARDS.json",
  "release_statuses": ["APROVADO", "CONDICIONADO", "HOLD", "REPROVADO"],
  "golden_rules": {
    "GR-034": {"name":"LI/BOM antes da imagem","status":"MANDATORY","rule":"A LI quantitativa e a BOM canônica devem ser elaboradas e validadas antes do desenho."},
    "GR-035": {"name":"Paridade quantitativa LI x desenho","status":"MANDATORY","rule":"Cada item desenhável deve aparecer no Data Sheet/layout e desenho exatamente na quantidade congelada na LI."},
    "GR-036": {"name":"Mudança da LI invalida desenho","status":"MANDATORY","rule":"Qualquer alteração de quantidade, catalog_id ou revisão na LI invalida carga, BOM, layout, imagem e QA anteriores."},
    "GR-037": {"name":"IHM na porta","status":"MANDATORY","rule":"IHM local deve permanecer na tampa/porta do quadro."},
    "GR-038": {"name":"Sem distorção","status":"MANDATORY","rule":"Componentes não podem ser reduzidos ou distorcidos para caber; reorganizar ou ampliar gabinete."},
    "GR-039": {"name":"Padrão único de Excel","status":"MANDATORY","rule":"PN-AUT-01 é o template mestre da planilha. PN-AUT-02 e futuros quadros devem manter a mesma estrutura visual/documental; somente dados técnicos específicos podem variar."},
    "GR-040": {"name":"Padrão visual único da imagem","status":"MANDATORY","rule":"Cada painel deve usar sua imagem aprovada e a composição visual mestre do projeto, uma imagem por painel, sem recomposição não autorizada."},
    "GR-041": {"name":"Padrão aprovado imutável sem autorização","status":"MANDATORY","rule":"Nenhuma alteração do template de Excel, padrão visual, dimensão mestre ou sequência pode ocorrer sem autorização explícita do responsável."},
    "GR-042": {"name":"Baseline da LI imutável","status":"MANDATORY","rule":"A revisão de LI congelada é baseline do painel e só pode mudar mediante nova revisão autorizada."},
    "GR-043": {"name":"Fingerprint estrutural do workbook","status":"MANDATORY","rule":"O workbook deve manter o fingerprint estrutural XLSX-PN-AUT-01-MASTER-R02."},
    "GR-044": {"name":"Fingerprint da imagem aprovada","status":"MANDATORY","rule":"O desenho deve apontar para o ID e SHA-256 da referência visual aprovada do painel."},
    "GR-045": {"name":"Prompt mestre obrigatório","status":"MANDATORY","rule":"O PROMPT-MASTER-AUT-PANEL-V2 deve ser carregado e não pode ser reescrito pelo agente."},
    "GR-050": {"name":"Revisões históricas imutáveis","status":"MANDATORY","rule":"Colunas de revisões já emitidas permanecem intactas; correções entram somente na nova revisão."},
    "GR-051": {"name":"Nova revisão na coluna adjacente","status":"MANDATORY","rule":"A nova revisão deve ficar imediatamente à direita da revisão anterior, preservando REV. 0 e demais revisões."},
    "GR-052": {"name":"Quantidade nova com evidência","status":"MANDATORY","rule":"Cada valor novo deve ter fonte rastreável ou cálculo determinístico baseado em fonte autorizada."},
    "GR-053": {"name":"A LEVANTAR controlado","status":"MANDATORY","rule":"A LEVANTAR só é permitido quando a quantidade não puder ser determinada e exige justificativa."},
    "GR-054": {"name":"Capa e formato preservados","status":"MANDATORY","rule":"Revisão de conteúdo não autoriza reconstruir ou alterar o template da LI."},
    "GR-055": {"name":"Diff estrutural e histórico","status":"MANDATORY","rule":"Toda revisão exige comparação baseline x nova versão para provar preservação histórica e estrutural."},
    "GR-056": {"name":"Memória de controle da LI","status":"MANDATORY","rule":"Cada revisão deve registrar fontes, alterações, pendências, QA e regressões na memória de controle da LI."},
    "GR-057": {"name":"Conflito de fonte vira HOLD","status":"MANDATORY","rule":"Conflitos não autorizam reescrever a revisão antiga; a nova revisão fica HOLD até reconciliação."},
    "GR-058": {"name":"QA open source em camadas","status":"MANDATORY","rule":"A cobertura de QA open source deve ser registrada; ferramenta opcional ausente não equivale a PASS total."}
  },
  "standard_sequence": ["DATACENTER","DATASHEET","SELECT","LI_QUANTITY","LOAD_BALANCE","BOM","LAYOUT","RENDER_IMAGE","QA","RELEASE"],
  "mandatory_panel_rules": {
    "independent_panel_model": true,
    "li_required_before_bom": true,
    "li_is_quantity_source": true,
    "li_historical_revisions_immutable": true,
    "li_preserve_rev_0": true,
    "li_new_revision_adjacent_right": true,
    "li_quantity_evidence_required": true,
    "li_a_levantar_requires_non_determinability": true,
    "li_cover_and_format_preserved": true,
    "li_revision_memory_required": true,
    "li_open_source_qa_coverage_required": true,
    "load_balance_required_before_layout": true,
    "load_balance_voltages": ["24VDC","127VAC","220VAC"],
    "bom_quantity_must_equal_li": true,
    "layout_quantity_must_equal_li": true,
    "render_quantity_must_equal_li": true,
    "li_change_invalidates_load_bom_layout_render": true,
    "front_external_master_geometry": true,
    "single_global_px_per_mm": true,
    "aspect_equal": true,
    "canvas_grow_only": true,
    "lower_cable_zone_required": true,
    "power_supply_required": true,
    "dc_ups_required": true,
    "battery_required": true,
    "hmi_on_door_required": true,
    "reference_model_required_for_every_li_line": true,
    "hold_when_exact_model_or_evidence_is_missing": true,
    "workbook_master_template_required": true,
    "workbook_master_panel": "PN-AUT-01",
    "workbook_template_id": "XLSX-PN-AUT-01-MASTER-R02",
    "workbook_structural_fingerprint_sha256": "c568858ed6d80cc2ccd4a8859d0a21f88cafddccc10737eda8808555b94530fc",
    "approved_image_visual_standard_required": true,
    "image_visual_standard_id": "IMG-AUT-PANEL-MASTER-V1",
    "one_panel_per_image": true,
    "prompt_master_required": true,
    "prompt_master_id": "PROMPT-MASTER-AUT-PANEL-V2",
    "li_material_prompt_id": "PROMPT-MASTER-LI-MATERIAL-V1",
    "standard_change_requires_explicit_authorization": true
  },
  "panel_standards": {
    "PN-AUT-01": {
      "role":"MASTER_PLC_VRF","floor":"1","li_file":"li/PN-AUT-01_LI.json","quantity_registry_key":"PN-AUT-01",
      "li_id":"LI-PN-AUT-01-R02","li_revision":"R02",
      "workbook_template_id":"XLSX-PN-AUT-01-MASTER-R02","image_template_id":"IMG-PN-AUT-01-APPROVED-V1",
