  "li_material_prompt": "prompts/PROMPT_MASTER_LI_MATERIAL.md",
  "li_material_pipesheets": "pipesheets/LI_MATERIAL_PIPE_SHEETS.yaml",
  "li_material_control": "datacenter/LI_MATERIAL_CONTROL.json",
  "li_material_datasheet": "datasheet/LI_MATERIAL_DATA_SHEET.json",
