      "enclosure_external_mm":{"width":400,"height":500,"depth":250},"mounting_plate_mm":{"width":350,"height":450},
      "mandatory_categories":["power_supply","dc_ups","battery","rtu_controller","hmi","industrial_switch","terminal","protective_device"]
    }
  },
  "github_quality": {"workflow":".github/workflows/aut-panel-quality.yml","pull_request_required":true,"block_on_rejected":true,"block_release_on_hold":true,"artifact_manifest_required":true},
  "stages": [
    {"order":10,"id":"INIT","input":["project_request"],"output":["project_structure"],"gates":["project_id","revision","panel_id"]},
    {"order":20,"id":"INGEST","input":["MD","ET","LI","PDF","XLSX","images"],"output":["document_manifest"],"gates":["sha256","source_registration"]},
    {"order":50,"id":"DATACENTER","input":["confirmed_requirements","manufacturer_documents"],"output":["verified_catalog","panel_quantity_registry","document_standard_registry","immutable_contracts","li_material_revision_contract"],"gates":["manufacturer","reference_model","quantity_registry","golden_rules","document_standard","prompt_master","li_material_prompt","template_fingerprint"]},
    {"order":60,"id":"DATASHEET","input":["confirmed_requirements","verified_catalog","document_standard_registry"],"output":["canonical_project"],"gates":["json_schema","li_contract","li_material_revision_contract","panel_independence","workbook_template_contract","image_template_contract","change_authorization_contract"]},
    {"order":90,"id":"SELECT","input":["calculation_results","verified_catalog"],"output":["selected_components"],"gates":["reference_model","lifecycle"]},
    {"order":100,"id":"LI_QUANTITY","input":["selected_components","panel_quantity_registry","li_material_revision_contract"],"output":["validated_li"],"gates":["quantity_positive","catalog_id_exists","registry_match","render_flag","workbook_master_template","li_revision_baseline","historical_revision_unchanged","rev_0_preserved","new_revision_adjacent","quantity_evidence","a_levantar_justified"]},
    {"order":105,"id":"LOAD_BALANCE","input":["validated_li","verified_catalog"],"output":["equipment_loads","total_24vdc","equivalent_127vac","equivalent_220vac"],"gates":["load_per_equipment","no_invented_consumption","traceability","HOLD_on_missing_load_data"]},
    {"order":110,"id":"BOM","input":["validated_li","verified_catalog","equipment_loads"],"output":["AUT_PANEL_BOM.json","AUT_PANEL_BOM.csv"],"gates":["bom_quantity_equals_li","reference_model_on_every_line"]},
    {"order":120,"id":"LAYOUT","input":["validated_li","equipment_loads","AUT_PANEL_BOM.json","canonical_project"],"output":["physical_layout"],"gates":["layout_quantity_equals_li","GR-018","GR-027","reserve"]},
    {"order":130,"id":"RENDER_IMAGE","input":["physical_layout","validated_li","AUT_PANEL_BOM.json","document_standard_registry","immutable_contracts"],"output":["AUT_PANEL_LAYOUT.svg"],"gates":["render_quantity_equals_li","hmi_on_door","approved_image_template","approved_image_fingerprint","one_panel_per_image","no_unapproved_recomposition","GR-021","GR-022","GR-023","GR-024","GR-025","GR-026","GR-040","GR-041","GR-044","GR-045"]},
    {"order":140,"id":"QA","input":["all_outputs"],"output":["qa_report","artifact_manifest"],"gates":["schema","unit_tests","hashes","cross_consistency","li_before_image","load_before_layout","quantity_parity","workbook_template_parity","image_template_parity","standard_change_authorization","li_historical_revision_diff","li_template_preservation","li_semantic_diff","li_open_source_qa_coverage","li_memory_sync"]},
    {"order":150,"id":"RELEASE","input":["qa_report","artifact_manifest"],"output":["release_package"],"gates":["APROVADO","no_HOLD","pull_request_review","two_agent_source_validation","reverification_done"]}
  ]
}
